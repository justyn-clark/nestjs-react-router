{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "outDir": "dist",
    "rootDir": "../..",
    "types": ["node", "vite/client"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "baseUrl": ".",
    "paths": {
      "@nestjs-react-router/env": ["../../packages/env/src/index.ts"],
      "@nestjs-react-router/env/*": ["../../packages/env/src/*"],
      "@nestjs-react-router/db": ["../../packages/db/src/index.ts"],
      "@nestjs-react-router/db/*": ["../../packages/db/src/*"],
      "@nestjs-react-router/redis": ["../../packages/redis/src/index.ts"],
      "@nestjs-react-router/redis/*": ["../../packages/redis/src/*"],
      "@nestjs-react-router/shared": ["../../packages/shared/src/index.ts"],
      "@nestjs-react-router/shared/*": ["../../packages/shared/src/*"]
    }
  },
  "include": [
    "../../packages/env/src",
    "../../packages/shared/src",
    "src",
    "../../packages/redis/src",
    "../web/vite-env.d.ts",
    "../../packages/db/src",
    "../web/src"
  ]
}
