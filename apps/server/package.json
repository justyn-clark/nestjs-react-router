{
  "name": "@nestjs-react-router/server",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "lint": "npx biome lint .",
    "lint:fix": "npx biome lint --write .",
    "format": "npx biome format --write .",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs-react-router/db": "workspace:*",
    "@nestjs-react-router/redis": "workspace:*",
    "@nestjs-react-router/shared": "workspace:*",
    "@fastify/cookie": "^9.3.1",
    "@fastify/static": "^7.0.4",
    "@nestjs/common": "^10.4.5",
    "@nestjs/core": "^10.4.5",
    "@nestjs/platform-fastify": "^10.4.5",
    "bullmq": "^5.12.1",
    "fastify": "^4.28.1",
    "fastify-plugin": "4.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}