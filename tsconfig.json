{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@nestjs-react-router/env": ["packages/env/src/index.ts"],
      "@nestjs-react-router/env/*": ["packages/env/src/*"],
      "@acme/shared/*": ["packages/shared/src/*"]
    }
  }
}
