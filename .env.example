# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/appdb

# Redis
REDIS_URL=redis://localhost:6379

# Cookie/session example
SESSION_SECRET=dev-secret-change-me

# Optional Docker host port overrides when common ports are already in use
NRR_APP_PORT=3000
NRR_POSTGRES_PORT=5432
NRR_REDIS_PORT=6379

# Optional internal origin for SSR self-fetch in containerized runtimes
APP_INTERNAL_ORIGIN=http://127.0.0.1:3000
